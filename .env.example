# Public support contact shown in the Help Center
VITE_SUPPORT_PHONE=+91 99725 98412
VITE_SUPPORT_EMAIL=imransyed0738@gmail.com

# Supabase values. Lovable Cloud supplies these after you connect a Supabase
# project. Do not put the service-role/secret key in a VITE_ variable: it must
# only be available to server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively, Supabase's newer secret-key name is supported:
# SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the independently deployed Cloudflare registration-email Worker.
VITE_EMAIL_WORKER_URL=

# Server-only values for automatic support email delivery through Resend
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
